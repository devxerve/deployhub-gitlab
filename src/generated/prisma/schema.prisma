generator client {
  provider = "prisma-client-js" // GENERA EL CLIENTE PARA NODE.JS / TYPESCRIPT
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // lee del .env la variable del url
}

model users {
  // Cambiamos dbgenerated por uuid() nativo de Prisma
  user_id       String   @id @default(uuid()) @db.Uuid
  username      String   @unique @db.VarChar(50)
  email         String   @unique @db.VarChar(100)
  password_hash String
  role          String?  @db.VarChar(20)
  created_at    DateTime @default(now()) @db.Timestamp(6)
}
