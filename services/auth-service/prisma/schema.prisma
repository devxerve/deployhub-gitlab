generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum DeploymentStatus {
  PENDING
  QUEUED
  BUILDING
  SUCCESS
  FAILED
}

model users {
  user_id       String    @id @default(uuid()) @db.Uuid
  username      String    @unique @db.VarChar(50)
  email         String    @unique @db.VarChar(100)
  password_hash String?   // Opcional: usuarios OAuth no tienen contraseña local
  provider      String?   @db.VarChar(20)  // 'local' | 'google' | 'github' | '42'
  provider_id   String?   @db.VarChar(255) // ID único del usuario en el proveedor
  role          String?   @db.VarChar(20)
  created_at    DateTime  @default(now()) @db.Timestamp(6)

  deployments   deploy[]

  @@unique([provider, provider_id]) // Un mismo provider_id no puede repetirse por proveedor
}

model deploy {
  deployment_id  String           @id @default(uuid()) @db.Uuid
  user_id        String           @db.Uuid

  status         DeploymentStatus @default(PENDING)
  repoUrl        String           @db.VarChar(255)
  commitHash     String?          @db.VarChar(255)
  envVariables   Json?
  port           Int?

  created_at     DateTime         @default(now()) @db.Timestamp(6)
  updated_at     DateTime         @updatedAt @db.Timestamp(6)

  user           users            @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}
