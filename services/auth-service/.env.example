# ============================================================
# Auth Service – Variables de entorno
# Copia este archivo a .env y rellena los valores reales.
# ============================================================

# Base de datos
DATABASE_URL=postgresql://user:password@db:5432/transcendence

# JWT
JWT_SECRET=super_secret_key_cambiame
JWT_EXPIRES_IN=1d

# Entorno
NODE_ENV=development
PORT=3001

# URL base del frontend (a donde redirigir tras el OAuth)
APP_BASE_URL=http://localhost:3000

# ────────────────────────────────────────────────
# GOOGLE  →  https://console.developers.google.com
# ────────────────────────────────────────────────
# 1. Crea un proyecto
# 2. "APIs & Services" → "Credentials" → "Create Credentials" → "OAuth 2.0 Client ID"
# 3. Tipo de aplicación: "Web application"
# 4. Authorized redirect URI: http://localhost:3001/auth/oauth/google/callback
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/oauth/google/callback

# ────────────────────────────────────────────────
# GITHUB  →  https://github.com/settings/developers
# ────────────────────────────────────────────────
# 1. "OAuth Apps" → "New OAuth App"
# 2. Homepage URL: http://localhost:3000
# 3. Authorization callback URL: http://localhost:3001/auth/oauth/github/callback
GITHUB_CLIENT_ID=tu_github_client_id
GITHUB_CLIENT_SECRET=tu_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:3001/auth/oauth/github/callback

# ────────────────────────────────────────────────
# 42 INTRA  →  https://profile.intra.42.fr/oauth/applications
# ────────────────────────────────────────────────
# 1. "New Application"
# 2. Redirect URI: http://localhost:3001/auth/oauth/42/callback
INTRA_CLIENT_ID=tu_42_client_id
INTRA_CLIENT_SECRET=tu_42_client_secret
INTRA_REDIRECT_URI=http://localhost:3001/auth/oauth/42/callback
