generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["backend"]
}

enum GitProvider {
  github
  gitlab

  @@schema("backend")
}

model Deploy {
  id           String   @id @default(cuid())
  userId       String
  repoUrl      String
  projectId    String
  status       String
  port         Int?
  commitHash   String?
  branch       String?
  envVariables String?
  createdAt    DateTime @default(now())

  @@schema("backend")
}

model DeployLog {
  id        String   @id @default(cuid())
  deployId  String
  message   String
  createdAt DateTime @default(now())

  @@index([deployId])
  @@schema("backend")
}

model Project {
  id            String   @id
  userId        String
  name          String
  repoUrl       String
  provider      GitProvider
  defaultBranch String   @default("main")
  description   String?
  createdAt     DateTime @default(now())

  @@schema("backend")
}
