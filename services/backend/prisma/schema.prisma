generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["backend"]
}

model Deploy {
  id           String   @id @default(cuid())
  repoUrl      String
  projectId    String
  status       String
  port         Int?
  commitHash   String?
  branch       String?
  envVariables String?
  createdAt    DateTime @default(now())

  @@schema("backend")
}
