# ============================================================
# DeployHub / Transcendence — Environment Variables
# Copy this file to .env and fill in the actual values:
#   cp .env.example .env
# ============================================================

# --- Database (PostgreSQL) ---
DB_USER=transcendence
DB_PASSWORD=CHANGE_ME
DB_NAME=transcendence

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# --- JWT ---
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING
JWT_EXPIRES_IN=1d

# --- Auth Service ---
PORT_AUTH_SERVICE=3001
APP_BASE_URL=https://localhost

# --- Google OAuth ---
# https://console.developers.google.com → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/oauth/google/callback

# --- GitHub OAuth ---
# https://github.com/settings/developers → OAuth Apps → New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/auth/oauth/github/callback

# --- 42 Intra OAuth ---
# https://profile.intra.42.fr/oauth/applications → New Application
INTRA_CLIENT_ID=
INTRA_CLIENT_SECRET=
INTRA_REDIRECT_URI=http://localhost:3001/auth/oauth/42/callback

# --- Frontend ---
NEXT_PUBLIC_API_URL=https://api.localhost
NEXT_PUBLIC_AUTH_SERVICE_URL=https://auth.localhost

# --- Backend (internal Docker networking) ---
AUTH_SERVICE_URL=http://auth_service:3001
PROMETHEUS_URL=http://prometheus:9090
