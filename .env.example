# --- Database (PostgreSQL) ---
DB_USER=transcendence
DB_PASSWORD=
DB_NAME=transcendence

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=

# --- JWT ---
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- Auth Service ---
PORT_AUTH_SERVICE=3001
APP_BASE_URL=https://localhost:8443

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@deployhub.com
ADMIN_PASSWORD=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://localhost:8443/auth/oauth/google/callback

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://localhost:8443/auth/oauth/github/callback

# --- 42 Intra OAuth ---
INTRA_CLIENT_ID=
INTRA_CLIENT_SECRET=
INTRA_REDIRECT_URI=https://localhost:8443/auth/oauth/42/callback

# --- Frontend ---
NEXT_PUBLIC_API_URL=https://localhost:8443/api/backend
NEXT_PUBLIC_AUTH_SERVICE_URL=https://auth.localhost:8443
NEXT_PUBLIC_GRAFANA_URL=https://grafana.localhost:8443

# --- Backend (internal Docker networking) ---
AUTH_SERVICE_URL=http://auth_service:3001
PROMETHEUS_URL=http://prometheus:9090

# --- Docker socket (DooD / Traefik provider) ---
#DOCKER_SOCK_PATH=/run/user/<uid>/docker.sock
